# Salin berkas ini menjadi ".env" lalu isi nilainya. Jangan commit ".env".
# Variabel baru didaftarkan di sini dan di "src/env.js" (PRD K-18).

# Turso (libSQL). Database bersama tim: migrasi hanya oleh satu orang.
DATABASE_URL="libsql://<nama-db>.turso.io"
TURSO_AUTH_TOKEN=""

# Better Auth. Secret minimal 32 karakter, misalnya hasil `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (satu-satunya metode masuk).
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini API, opsional sampai WP-08 (K-14). Hanya dipakai di server.
GEMINI_API_KEY=""
